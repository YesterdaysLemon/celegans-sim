.venv/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
build/
dist/
.DS_Store

# Downloaded anatomy. Regenerate with tools/fetch_raw.sh; the built dataset
# (data/celegans.json) is committed so a fresh clone runs immediately.
data/raw/

# Scratch output from parameter sweeps.
scratch/

# WASM toolchain, installed locally by wasm/package.json. No trailing slash: Git
# classifies a directory symlink as a file on POSIX, and worktrees may link this path.
/wasm/node_modules
web/conform.json

# CI tooling (puppeteer-core). The viewer itself has no dependencies. Keep this
# symlink-safe for isolated worktrees for the same reason as the WASM dependency path.
/node_modules

# Generated by wasm/trajectories.mjs for tools/parity.py. Large, and regenerated
# on demand like web/conform.json.
web/traj-wasm.bin
web/traj-wasm.json
# Event times from wasm/egglaying.mjs, for tools/egglaying.py clustering.
web/egg-events.json
.loop_medium_cache.jsonl
.fv_phase_cache.jsonl
.amine_gait_cache.jsonl
